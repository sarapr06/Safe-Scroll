# Add your keys here. Copy this file to .env and fill in values.
# NEVER commit .env to git!

PORT=4000
FRONTEND_URL=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Optional: when free-tier quota is hit, app tries fallback models (gemma-3-12b-it, etc.).
# To prefer gemma (separate quota): GEMINI_MODEL=gemma-3-12b-it
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Presage API (for human sensing)
PRESAGE_API_KEY=your_presage_api_key

# MongoDB Atlas (use SRV from Atlas Connect -> Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/safescroll?retryWrites=true&w=majority
# If SSL alert 80 on Node 24: use standard format from Atlas Connect (or example below)
# MONGODB_URI_STANDARD=mongodb://user:password@ac-xxxxx-shard-00-00.xx.mongodb.net:27017,ac-xxxxx-shard-00-01.xx.mongodb.net:27017,ac-xxxxx-shard-00-02.xx.mongodb.net:27017/safescroll?retryWrites=true&w=majority&tls=true
# If SSL alert 80 persists (macOS/OpenSSL): MONGODB_TLS_INSECURE=true (dev only)
