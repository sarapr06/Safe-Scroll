# Add your keys here. Copy this file to .env and fill in values.
# NEVER commit .env to git!

PORT=4000
FRONTEND_URL=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Optional: try gemini-2.5-flash if 2.0-flash quota is exhausted (different model = separate quota)
# GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Presage API (for human sensing)
PRESAGE_API_KEY=your_presage_api_key

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/safescroll?retryWrites=true&w=majority
